{
  "name": "even-g2-hud",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Driving HUD plugin for Even Realities G2 glasses",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "qr": "evenhub qr --port 5173",
    "sim": "evenhub-simulator http://localhost:5173/?demo",
    "pack": "npm run build && evenhub pack app.json dist -o drive-hud.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
